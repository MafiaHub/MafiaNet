# EditorConfig -- https://editorconfig.org
# Mirrors .clang-format. No end_of_line: the tree mixes CRLF and LF files, and
# forcing either would rewrite whole files on save.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,cc,cxx,h,hpp,hxx,inl}]
indent_style = tab
indent_size = 4
tab_width = 4

[{CMakeLists.txt,*.cmake,CMakePresets.json}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{md,rst}]
indent_style = space
trim_trailing_whitespace = false
